rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 256)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is string) &&
             (!('lastLoginAt' in data) || data.lastLoginAt is string);
    }

    // Match rules for user profiles
    match /users/{uid} {
      // Allow read only to the owner of the document
      allow get: if isOwner(uid) && isValidId(uid);
      
      // Prevent unauthorized list queries on all user accounts
      allow list: if false;

      // Allow creation of own profile document with valid payload
      allow create: if isOwner(uid) && 
                       isValidId(uid) && 
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.uid == request.auth.uid;

      // Allow updates to own profile document while preventing hijacking or createdAt mutation
      allow update: if isOwner(uid) && 
                       isValidId(uid) && 
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.uid == resource.data.uid &&
                       (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      // Deny deletion from client for data retention
      allow delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
