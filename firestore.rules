rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipant(data) {
      return isSignedIn() && data.participants is list && request.auth.uid in data.participants;
    }

    function isConnectionParticipant(data) {
      return isSignedIn() && data.users is list && request.auth.uid in data.users;
    }

    function validExternalURL(value) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= 2000 &&
        value.matches('^https?://.*');
    }

    function validExternalMediaEntry(entry) {
      return entry is map &&
        entry.id is string &&
        entry.id.size() <= 100 &&
        validExternalURL(entry.externalUrl) &&
        entry.type in ['image', 'video', 'menu', 'website', 'other'] &&
        entry.contributorId is string &&
        entry.contributorId.size() <= 128 &&
        entry.createdAt is string;
    }

    function validExternalMediaList(entries) {
      return entries is list &&
        entries.size() <= 10 &&
        (entries.size() == 0 || validExternalMediaEntry(entries[0])) &&
        (entries.size() <= 1 || validExternalMediaEntry(entries[1])) &&
        (entries.size() <= 2 || validExternalMediaEntry(entries[2])) &&
        (entries.size() <= 3 || validExternalMediaEntry(entries[3])) &&
        (entries.size() <= 4 || validExternalMediaEntry(entries[4])) &&
        (entries.size() <= 5 || validExternalMediaEntry(entries[5])) &&
        (entries.size() <= 6 || validExternalMediaEntry(entries[6])) &&
        (entries.size() <= 7 || validExternalMediaEntry(entries[7])) &&
        (entries.size() <= 8 || validExternalMediaEntry(entries[8])) &&
        (entries.size() <= 9 || validExternalMediaEntry(entries[9]));
    }

    function validExternalLinkList(links) {
      return links is list &&
        links.size() <= 10 &&
        (links.size() == 0 || validExternalURL(links[0])) &&
        (links.size() <= 1 || validExternalURL(links[1])) &&
        (links.size() <= 2 || validExternalURL(links[2])) &&
        (links.size() <= 3 || validExternalURL(links[3])) &&
        (links.size() <= 4 || validExternalURL(links[4])) &&
        (links.size() <= 5 || validExternalURL(links[5])) &&
        (links.size() <= 6 || validExternalURL(links[6])) &&
        (links.size() <= 7 || validExternalURL(links[7])) &&
        (links.size() <= 8 || validExternalURL(links[8])) &&
        (links.size() <= 9 || validExternalURL(links[9]));
    }

    function validProfile(data) {
      return data.uid is string &&
        data.uid == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() <= 120 &&
        data.bio is string &&
        data.bio.size() <= 500 &&
        data.homeCountry is string &&
        data.homeCountry.size() <= 120 &&
        data.currentCountry is string &&
        data.currentCountry.size() <= 120 &&
        data.currentCity is string &&
        data.currentCity.size() <= 120 &&
        data.languages is list &&
        data.languages.size() <= 10 &&
        data.interests is list &&
        data.interests.size() <= 20 &&
        data.onboardingCompleted is bool &&
        (!('showOnMap' in data) || data.showOnMap is bool);
    }

    function validUserProfile(data) {
      return data.uid is string &&
        data.uid == request.auth.uid &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('homeCountry' in data) || (data.homeCountry is string && data.homeCountry.size() <= 120)) &&
        (!('currentCountry' in data) || (data.currentCountry is string && data.currentCountry.size() <= 120)) &&
        (!('currentCity' in data) || (data.currentCity is string && data.currentCity.size() <= 120)) &&
        (!('languages' in data) || (data.languages is list && data.languages.size() <= 10)) &&
        (!('interests' in data) || (data.interests is list && data.interests.size() <= 20)) &&
        (!('onboardingCompleted' in data) || data.onboardingCompleted is bool) &&
        (!('showOnMap' in data) || data.showOnMap is bool) &&
        (!('createdAt' in data) || data.createdAt is string) &&
        (!('updatedAt' in data) || data.updatedAt is string) &&
        (!('lastLoginAt' in data) || data.lastLoginAt is string) &&
        (!('lastActiveAt' in data) || data.lastActiveAt is string);
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validUserProfile(request.resource.data);
      allow update: if isOwner(uid) && validUserProfile(request.resource.data) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(uid) && validProfile(request.resource.data);
      allow update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /userContext/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.currentNeed is string &&
        request.resource.data.currentNeed.size() <= 120 &&
        request.resource.data.currentCity is string &&
        request.resource.data.currentCity.size() <= 120 &&
        request.resource.data.updatedAt is string;
      allow delete: if isOwner(uid);
    }

    match /connections/{connectionId} {
      allow get, list: if isConnectionParticipant(resource.data);
      allow create: if isSignedIn() &&
        isConnectionParticipant(request.resource.data) &&
        request.resource.data.users.size() == 2 &&
        request.resource.data.users[0] != request.resource.data.users[1] &&
        request.resource.data.initiatedBy == request.auth.uid &&
        (request.resource.data.status == 'pending' || request.resource.data.status == 'blocked');
      allow update: if isConnectionParticipant(resource.data) &&
        isConnectionParticipant(request.resource.data) &&
        request.resource.data.users == resource.data.users &&
        request.resource.data.initiatedBy == resource.data.initiatedBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt is string &&
        request.resource.data.status in ['accepted', 'declined', 'blocked'] &&
        (request.resource.data.status == 'blocked' ||
          (resource.data.status == 'pending' && resource.data.initiatedBy != request.auth.uid));
      allow delete: if isConnectionParticipant(resource.data);
    }

    match /conversations/{conversationId} {
      allow get, list: if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data) &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants[0] != request.resource.data.participants[1];
      allow update: if isParticipant(resource.data) &&
        isParticipant(request.resource.data) &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if isParticipant(resource.data);

      match /messages/{messageId} {
        allow get, list: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
          request.resource.data.conversationId == conversationId &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;
        // Messages are immutable in the current client; deny arbitrary participant edits.
        allow update: if false;
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.updatedAt is string;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /places/{placeId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 160 &&
        request.resource.data.category in ['restaurant', 'hostel', 'hotel', 'cafe', 'coworking', 'bar', 'accommodation', 'event', 'job', 'attraction', 'shop', 'service', 'wifi', 'camping', 'other'] &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 5000 &&
        request.resource.data.city is string &&
        request.resource.data.city.size() > 0 &&
        request.resource.data.city.size() <= 120 &&
        request.resource.data.country is string &&
        request.resource.data.country.size() <= 120 &&
        validExternalMediaList(request.resource.data.media) &&
        (request.resource.data.latitude == null || request.resource.data.latitude is number) &&
        (request.resource.data.longitude == null || request.resource.data.longitude is number) &&
        request.resource.data.claimedBy == null &&
        request.resource.data.verified == false &&
        request.resource.data.verificationStatus == 'unverified' &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string;
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.claimedBy == resource.data.claimedBy &&
        request.resource.data.verified == resource.data.verified &&
        request.resource.data.verificationStatus == resource.data.verificationStatus;
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /media/{mediaId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.id == mediaId &&
          request.resource.data.placeId == placeId &&
          request.resource.data.contributorId == request.auth.uid &&
          validExternalMediaEntry(request.resource.data);
        allow update: if isSignedIn() && resource.data.contributorId == request.auth.uid &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.placeId == resource.data.placeId &&
          request.resource.data.contributorId == resource.data.contributorId;
        allow delete: if isSignedIn() && resource.data.contributorId == request.auth.uid;
      }

      match /placeContributions/{placeContributionId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.placeId == placeId &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.kind in ['recommendation', 'correction', 'photo', 'menu', 'tip', 'wifi', 'review'] &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          validExternalMediaList(request.resource.data.media) &&
          request.resource.data.metadata is map &&
          request.resource.data.createdAt is string;
        allow update: if isSignedIn() && resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.placeId == resource.data.placeId;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    match /posts/{postId} {
      allow get, list: if isSignedIn() &&
        (resource.data.visibility == 'public' || resource.data.authorId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() <= 120 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 5000 &&
        request.resource.data.city is string &&
        request.resource.data.city.size() <= 120 &&
        validExternalMediaList(request.resource.data.media) &&
        request.resource.data.media.size() <= 4 &&
        (request.resource.data.linkUrl == null || validExternalURL(request.resource.data.linkUrl)) &&
        request.resource.data.mediaUrl == null &&
        request.resource.data.visibility in ['public', 'friends'] &&
        request.resource.data.reactionCount is int &&
        request.resource.data.commentCount is int &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string;
      allow update: if isSignedIn() &&
        request.resource.data.authorId == resource.data.authorId &&
        (resource.data.authorId == request.auth.uid ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
            request.resource.data.commentCount == resource.data.commentCount + 1));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /comments/{commentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000 &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() <= 120 &&
        request.resource.data.createdAt is string;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /reactions/{reactionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /contributions/{contributionId} {
      allow get, list: if isSignedIn() && resource.data.status == 'published';
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.type in ['place', 'restaurant', 'hostel', 'hotel', 'cafe', 'coworking', 'bar', 'event', 'job', 'accommodation', 'attraction', 'shop', 'wifi', 'camping', 'local-tip', 'guide', 'photo', 'video', 'service', 'other'] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 160 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 5000 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() <= 200 &&
        request.resource.data.city is string &&
        request.resource.data.city.size() <= 120 &&
        (request.resource.data.placeId == null || request.resource.data.placeId is string) &&
        request.resource.data.country is string &&
        request.resource.data.country.size() <= 120 &&
        validExternalMediaList(request.resource.data.media) &&
        validExternalLinkList(request.resource.data.links) &&
        request.resource.data.metadata is map &&
        request.resource.data.status in ['published', 'draft'] &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid &&
        request.resource.data.authorId == resource.data.authorId;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.type in ['friend-request', 'friend-accepted', 'message', 'comment', 'reaction'] &&
        request.resource.data.entityId is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.read == false &&
        request.resource.data.createdAt is string;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.recipientId == resource.data.recipientId &&
        request.resource.data.read is bool;
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reportedUserId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 500;
      allow get, list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
