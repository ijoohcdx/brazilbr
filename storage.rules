rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validImage() {
      return request.resource != null &&
        request.resource.size <= 5242880 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function validMedia() {
      return request.resource != null &&
        request.resource.size <= 52428800 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'video/mp4', 'video/webm'];
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && validImage();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/posts/{postId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && validMedia();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/contributions/{contributionId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && validMedia();
      allow delete: if isOwner(uid);
    }

    match /places/{placeId}/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && validMedia();
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
