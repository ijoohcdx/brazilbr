{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(home|onboarding|map|place|discover|profile|messages|conversation|groups|search|contribute|notifications|friends)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!assets/|robots\\.txt|sitemap\\.xml|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
